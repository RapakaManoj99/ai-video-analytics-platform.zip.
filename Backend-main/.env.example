# LLM provider: false = Groq, true = OpenAI
USE_OPENAI=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
