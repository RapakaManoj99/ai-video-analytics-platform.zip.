# Data database (Supabase project holding the analytics tables)
SUPABASE_URL=
SUPABASE_KEY=
# Direct Postgres connection used for executing generated SQL
DATABASE_URL=

# Separate Supabase project for chat history / workspace state
HISTORY_SUPABASE_URL=
